{
  // ==========================================
  // 1. إعدادات التسجيل الافتراضية الخاصة بـ .NET Framework
  // ==========================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // السماح باستقبال الطلبات من أي Host (مناسب لبيئة التطوير Local)
  "AllowedHosts": "*",

  // ==========================================
  // 2. نص الاتصال بقاعدة البيانات (SQL Server Connection String)
  // ==========================================
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=AYMAN\\MSSQLSERVER01;Database=ClinicOS;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True;Packet Size=4096;Command Timeout=0"
  },

  // ==========================================
  // 3. إعدادات الـ CORS (عناوين الـ Frontend المسموح لها بالاتصال)
  // ==========================================
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5500"
    ]
  },

  // ==========================================
  // 4. إعدادات مكتبة Serilog للتسجيل الهيكلي (Structured Logging)
  // ==========================================
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  // ==========================================
  // 5. إعدادات الـ JWT (التوثيق)
  // ==========================================
  "Jwt": {
    "Key": "ضع-هنا-سر-طويل-عشوائي-32-حرف-على-الأقل-ومختلف-عن-سر-الـ-OTP",
    "Issuer": "ClinicOS.Api",
    "Audience": "ClinicOS.Client",
    "StaffExpiryMinutes": 60,
    "PatientExpiryMinutes": 15
  },

  // ==========================================
  // 6. إعدادات البريد الإلكتروني (SMTP)
  // ==========================================
  "MailSettings": {
    "SenderEmail": "noreply@clinic-os.com",
    "SenderName": "ClinicOS System",
    "ClinicName": "ClinicOS",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "EnableSsl": true
  },

  // ==========================================
  // 7. إعدادات تخزين الملفات (File Storage)
  // ==========================================
  "FileStorage": {
    "Provider": "Local",
    "RootFolder": "UploadedFiles",
    "CreateIfNotExists": true,
    "MaxFileSizeInMB": 10,
    "GenerateUniqueFileName": true,
    "PreserveOriginalFileName": false,
    "OverwriteExistingFiles": false,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".svg",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".zip",
      ".rar",
      ".7z"
    ]
  },

  // ==========================================
  // 8. إعدادات الرابط الأساسي للتطبيق (Base URL)
  // ==========================================
  "BaseUrl": {
    "BaseUrl": "https://localhost:7271"
  },

  // ==========================================
  // 9. إعدادات رمز التحقق (OTP Settings)
  // ==========================================
  "OtpSettings": {
    "CodeLength": 6,
    "Expiry": "00:05:00",
    "ResendCooldown": "00:01:00",
    "MaxAttempts": 3,
    "HashingSecret": "YourSuperSecretOtpHashingSecretKeyHere_Minimum32Characters!"
  }
}