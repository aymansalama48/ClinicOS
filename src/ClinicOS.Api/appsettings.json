    "HangfireConnection": "Data Source=AYMAN\\MSSQLSERVER01;Database=ClinicOS;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True;Packet Size=4096;Command Timeout=0"
